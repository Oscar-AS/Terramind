{
  "expo": {
    "name": "TerraMind",
    "slug": "terramind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terramindafrique.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4D3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.terramindafrique.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TerraMind utilise ta position pour connaître le sol et la météo de ton champ."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "TerraMind utilise l'appareil photo pour examiner une feuille de ta plante.",
          "photosPermission": "TerraMind lit la photo de feuille que tu choisis."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "TerraMind utilise le micro pour écouter la question que tu poses à voix haute, en wolof.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "scheme": "terramind",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "e3a4dc49-dd12-447a-91dc-6157f733d031"
      }
    },
    "owner": "aliounekane"
  }
}
