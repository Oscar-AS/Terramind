# Copier en .env et remplir localement. Ne jamais commiter .env.

# --- WhatsApp Cloud API (Meta) ---
# Tout se trouve dans developers.facebook.com > ton app > WhatsApp > API Setup,
# sauf mention contraire. Ne jamais coller ces valeurs dans un chat ni un commit.
# Jeton d'accès : temporaire (« Generate access token », expire en ~24 h)
# puis permanent (Paramètres de l'entreprise > Utilisateurs système > Générer un jeton)
WHATSAPP_TOKEN=
# « Phone number ID » affiché sous le numéro de test (ce n'est pas le numéro lui-même)
WHATSAPP_PHONE_NUMBER_ID=
# « WhatsApp Business Account ID » affiché sur la même page
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Secret de l'app : Paramètres de l'app > Général > Clé secrète (sert à vérifier la signature des webhooks)
WHATSAPP_APP_SECRET=
# Mot de passe inventé par l'équipe, à recopier dans Configuration > Webhook > Verify token
WHATSAPP_VERIFY_TOKEN=
# Version de l'API Graph utilisée par le moteur (celle affichée dans les exemples d'API Setup)
WHATSAPP_API_VERSION=v27.0

# --- Supabase ---
# URL du projet Supabase
SUPABASE_URL=
# Clé d'API Supabase
SUPABASE_KEY=

# --- Hugging Face ---
# Jeton en lecture (huggingface.co > Settings > Access Tokens), pour les modèles wolof sur demande
HF_TOKEN=

# --- LLM ---
# Clé d'API du fournisseur LLM (TODO: fournisseur à choisir)
LLM_API_KEY=

# --- Moteur ---
# URL publique du moteur FastAPI, utilisée par les façades
ENGINE_URL=

# --- Diagnostic ---
# Chemin local vers les poids du modèle de diagnostic (hors Git)
MODEL_PATH=
# Seuil de confiance en dessous duquel la réponse est « incertain » (TODO: à fixer après évaluation)
DIAGNOSTIC_CONFIDENCE_THRESHOLD=
