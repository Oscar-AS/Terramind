# TerraMind Afrique · variables d'environnement
# Copier en .env et remplir localement. Ne jamais commiter .env ni coller ses valeurs dans un chat.
# L'app mobile lit son adresse du moteur dans channels/mobile/.env (EXPO_PUBLIC_ENGINE_URL).

# === Moteur (engine/) : diagnostic photo ===
# Dossier du modèle ONNX (hors Git). Vide = modeles/diagnostic/
MODEL_PATH=
# Seuil « incertain ». Vide = seuil calibré du modèle (recommandé)
DIAGNOSTIC_CONFIDENCE_THRESHOLD=
# Dossier des fiches du RAG. Vide = content/fiches/
FICHES_PATH=

# === Gemini (réponses aux questions libres, RAG) : aistudio.google.com > Get API key ===
# Clé d'API Google AI Studio
GEMINI_API_KEY=
# Modèle utilisé
GEMINI_MODEL=gemini-3.5-flash-lite
# Plafond d'appels à Gemini par jour (au-delà : réponse tirée de la fiche, sans Gemini). Défaut : 500
GEMINI_APPELS_PAR_JOUR=

# === Telegram (@TerraMindAfriqueBot) : @BotFather > /mybots ===
# Jeton du bot donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Mot de passe inventé par l'équipe (pas fourni par Telegram) : Telegram le renvoie
# à chaque message, le moteur refuse ce qui ne le porte pas. À recopier tel quel dans Render.
TELEGRAM_WEBHOOK_SECRET=

# === Octopus (octoopus.dev, plateforme du PAS Challenge) : comprendre les notes vocales en wolof ===
# Jeton d'API de 30 jours (octoopus.dev > Developers). Vide = notes vocales non comprises
OCTOPUS_API_KEY=
# Projet sponsorisé de l'équipe, qui porte les crédits du challenge
OCTOPUS_PROJECT_ID=
# Plafond de minutes transcrites par jour (0,20 $ la minute). Vide = 20
OCTOPUS_MINUTES_PAR_JOUR=
# Plafond de réponses dites en wolof par jour (0,02 $ chacune). Vide = 100
OCTOPUS_REPONSES_VOCALES_PAR_JOUR=

# === Hugging Face : huggingface.co > Settings > Access Tokens ===
# Jeton en lecture, pour télécharger les modèles wolof (scripts/outils/telecharger_modeles.py)
HF_TOKEN=

# === Supabase : pas encore utilisé par le code (prévu pour le tableau de bord) ===
# URL du projet
SUPABASE_URL=
# Clé d'API
SUPABASE_KEY=

# === WhatsApp : archivé (D12), variables dans archives/whatsapp/env.example ===

# === Render : lien secret qui lance un déploiement (Settings > Deploy Hook). Ne jamais le publier ===
RENDER_DEPLOY_HOOK=
