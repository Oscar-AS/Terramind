# (URL, dates et empreintes SHA-256 dans data/raw/MANIFESTE.csv)
data/raw/nasa_power/
data/raw/wfp_prix/
data/raw/documents/
data/raw/images/

# Poids des modèles (plusieurs Go), téléchargés par scripts/outils/telecharger_modeles.py
modeles/
data/raw/kallaama/
