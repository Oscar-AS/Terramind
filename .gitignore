# --- Secrets ---
.env
.env.*
!.env.example

# --- Environnements virtuels / dépendances ---
.venv/
venv/
env/
ENV/
.conda/
node_modules/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Modèles entraînés (jamais dans Git) ---
*.pt
*.pth
*.onnx
*.h5
*.safetensors
*.ckpt

# --- Rasters et gros jeux d'images ---
*.tif
*.tiff
*.zip

# --- Retours terrain non anonymisés ---
# Seul le sous-dossier anonymises/ peut être commité.
research/retours/*
!research/retours/.gitkeep
!research/retours/anonymises/

# --- Système / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Données brutes volumineuses, retéléchargeables ---
